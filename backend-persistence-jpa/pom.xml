    </description>

    <dependencies>
        <dependency>
            <groupId>com.example.orders</groupId>
            <artifactId>backend-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
